{
  "name": "chatbot-rastreo-pedidos",
  "version": "1.0.0",
  "private": true,
  "description": "Chatbot web para consultar el estatus y la ubicación de pedidos.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
